    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">ProfileData</string>
        <string name="Source"><![CDATA[-- Pure retry-safe storage transforms. Cash excludes lifetime purchased credits.
local Data = {}
function Data.copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, entry in pairs(value) do result[key] = Data.copy(entry) end
    return result
end
function Data.acquire(old, defaults, token, now, leaseSeconds)
    local value = Data.copy(old or { Data = defaults, Purchased = 0, Receipts = {} })
    if value.Lease and value.Lease.Owner ~= token and value.Lease.Expires > now then
        return nil, "Your profile is still active on another server. Please retry shortly."
    end
    value.Lease = { Owner = token, Expires = now + leaseSeconds }
    return value
end
function Data.commit(old, snapshot, token, now, leaseSeconds, receipt, release)
    if not old or not old.Lease or old.Lease.Owner ~= token then return nil, "Session ownership changed." end
    local value = Data.copy(old)
    value.Data = Data.copy(snapshot)
    value.Data.Purchased = nil
    value.Purchased = value.Purchased or 0
    value.Receipts = value.Receipts or {}
    if receipt and not value.Receipts[receipt.Id] then
        value.Receipts[receipt.Id] = receipt.Credits
        value.Purchased += receipt.Credits
    end
    value.Lease = if release then nil else { Owner = token, Expires = now + leaseSeconds }
    return value
end
return Data
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">Rules</string>
        <string name="Source"><![CDATA[-- Pure game rules: the server owns state; tests can run without the Roblox engine.
local Rules = {}
function Rules.newProfile()
    return { Cash = 0, Purchased = 0, Escapes = 0, Rescues = 0, BestMs = 0,
        Skin = "Intake", Owned = { Intake = true }, Upgrades = { Sprint = 0, Stamina = 0, Stealth = 0 } }
end
function Rules.balance(profile) return profile.Cash + profile.Purchased end
function Rules.newRun(now)
    return { Started = now, Key = false, Power = false, Rescued = {}, Scrap = {},
        ScrapDone = false, RadioDone = false, Finished = false }
end
function Rules.count(items)
    local n = 0
    for _, value in pairs(items) do if value then n += 1 end end
    return n
end
function Rules.objective(run)
    if not run.Key then return "01", "STEAL A KEYCARD", "Find the guard office in the west wing.", "key" end
    if not run.Power then return "02", "CUT THE POWER", "Reach the generator in the east utility yard.", "power" end
    return "03", "REACH THE ESCAPE BOAT", "Rescue the optional inmates, then head north to the dock.", "exit"
end
function Rules.interact(run, profile, id, now, config)
    if run.Finished then return false, "Your next run is starting." end
    if id == "key" then
        if run.Key then return false, "You already have the keycard." end
        run.Key = true
        return true, "Keycard acquired. Police can now spot you. Find the generator."
    elseif id == "power" then
        if not run.Key then return false, "You need the guard's keycard." end
        if run.Power then return false, "Security is already disabled for this run." end
        run.Power = true
        return true, "Security disabled. Rescue the inmates or head to the escape boat."
    elseif id == "foreman" then
        if run.ScrapDone then return false, "Workshop quest already completed this run." end
        if Rules.count(run.Scrap) < 5 then return false, "Find all five scrap bundles first." end
        run.ScrapDone = true
        return true, "Workshop quest complete. +100 cash when you escape."
    elseif id == "radio" then
        if not run.Power then return false, "Disable security before sending the radio message." end
        if run.RadioDone then return false, "Radio quest already completed this run." end
        run.RadioDone = true
        return true, "Escape coordinates sent. +80 cash when you escape."
    elseif id == "exit" then
        if not run.Key or not run.Power then return false, "Steal the keycard and cut the power first." end
        local rescued = Rules.count(run.Rescued)
        local reward = config.BaseReward + rescued * config.RescueReward
            + (if run.ScrapDone then config.ScrapReward else 0)
            + (if run.RadioDone then config.RadioReward else 0)
        local ms = math.max(1, math.floor((now - run.Started) * 1000))
        profile.Cash += reward; profile.Escapes += 1; profile.Rescues += rescued
        if profile.BestMs == 0 or ms < profile.BestMs then profile.BestMs = ms end
        run.Finished = true
        return true, "ESCAPED! +" .. reward .. " cash", { Reward = reward, Rescues = rescued, TimeMs = ms }
    end
    local kind, value = string.match(id, "^(%w+):(.+)$")
    if kind == "scrap" then
        local index = tonumber(value)
        if not index or index % 1 ~= 0 or index < 1 or index > 5 or tostring(index) ~= value then return false, "Unknown scrap bundle." end
        if run.Scrap[value] then return false, "You already collected this bundle." end
        run.Scrap[value] = true
        return true, "Scrap " .. Rules.count(run.Scrap) .. "/5. Bring all five to the workshop foreman."
    elseif kind == "rescue" then
        local cast
        for _, inmate in ipairs(config.Cast) do if inmate.Id == value then cast = inmate end end
        if not cast then return false, "Unknown inmate." end
        if not run.Power then return false, "Cut the power to release the cell locks." end
        if run.Rescued[value] then return false, "This inmate is already following you." end
        run.Rescued[value] = true
        return true, cast.Name .. " is following you. Get to the boat for the rescue bonus."
    end
    return false, "Unknown interaction."
end
function Rules.buy(profile, category, id, config)
    if category == "Skin" then
        local skin = config.Skins[id]
        if not skin then return false, "Unknown skin." end
        if not profile.Owned[id] then
            if Rules.balance(profile) < skin.Price then return false, "Not enough cash." end
            profile.Cash -= skin.Price; profile.Owned[id] = true
        end
        profile.Skin = id
        return true, skin.Name .. " equipped."
    elseif category == "Upgrade" then
        local upgrade = config.Upgrades[id]
        if not upgrade then return false, "Unknown upgrade." end
        local level = profile.Upgrades[id]
        if level >= upgrade.Max then return false, "Already fully upgraded." end
        local price = upgrade.Prices[level + 1]
        if Rules.balance(profile) < price then return false, "You need " .. price .. " cash." end
        profile.Cash -= price; profile.Upgrades[id] += 1
        return true, upgrade.Name .. " upgraded to level " .. profile.Upgrades[id] .. "."
    end
    return false, "Unknown purchase."
end
return Rules
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">Game</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Market = game:GetService("MarketplaceService")
local Config = require(RS.Config)
local Rules = require(RS.Rules)
local Profiles = require(script.Parent.Modules.Profiles)
local World = require(script.Parent.Modules.World)
local Patrols = require(script.Parent.Modules.Patrols)
local network = Instance.new("Folder"); network.Name = "LockbreakNetwork"; network.Parent = RS
local function remote(name)
    local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = network; return r
end
local action, state, notice, board = remote("Action"), remote("State"), remote("Notice"), remote("Board")
local world = World.build(Config)
local patrols = Patrols.new(world)
local sessions, joining = {}, {}
local closing = false

local function tell(player, message, kind, result)
    if player.Parent then notice:FireClient(player, message, kind or "info", result) end
end
local function appearance(player)
    local s = sessions[player]; local character = player.Character
    if not s or not character then return end
    local color = Color3.fromRGB(table.unpack(Config.Skins[s.Profile.Skin].RGB))
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("Accessory") then item:Destroy() end
        if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" and item.Name ~= "Head" then item.Color = color end
    end
    local bodyColors = character:FindFirstChildOfClass("BodyColors")
    if bodyColors then
        bodyColors.TorsoColor3 = color; bodyColors.LeftArmColor3 = color; bodyColors.RightArmColor3 = color
        bodyColors.LeftLegColor3 = color; bodyColors.RightLegColor3 = color
    end
    local h = character:FindFirstChildOfClass("Humanoid")
    if h then h.DisplayName = Config.PlayerRole .. " · PARODY" .. (if s.VIP then " / VIP" else "") end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root and s.VIP and not root:FindFirstChild("VIPTrail") then
        local a = Instance.new("Attachment"); a.Position = Vector3.new(-0.8,0,0); a.Parent = root
        local b = Instance.new("Attachment"); b.Position = Vector3.new(0.8,0,0); b.Parent = root
        local trail = Instance.new("Trail"); trail.Name = "VIPTrail"; trail.Attachment0 = a; trail.Attachment1 = b
        trail.Color = ColorSequence.new(Color3.fromRGB(255,208,85)); trail.Lifetime = 0.7; trail.Parent = root
    end
end
local function push(player)
    local s = sessions[player]
    if not s or not player.Parent then return end
    local d = s.Profile
    local step, title, detail, targetId = Rules.objective(s.Run)
    local node = world.Nodes[targetId]
    local stats = player:FindFirstChild("leaderstats")
    if stats then stats.Cash.Value = Rules.balance(d); stats.Escapes.Value = d.Escapes; stats.Rescues.Value = d.Rescues end
    state:FireClient(player, {
        Cash = Rules.balance(d), Escapes = d.Escapes, Rescues = d.Rescues, BestMs = d.BestMs,
        Skin = d.Skin, Owned = d.Owned, Upgrades = d.Upgrades, VIP = s.VIP,
        Objective = { Step = step, Title = title, Detail = detail, Target = node.Part.Position },
        Run = s.Run, Heat = s.Heat, Stamina = s.Stamina, MaxStamina = 100 + d.Upgrades.Stamina*20,
        Elapsed = os.clock()-s.Run.Started, Persistent = Profiles.Persistent, Frozen = s.Frozen,
        Payments = Profiles.Persistent and Profiles:Available(player), Sprinting = s.Sprinting,
    })
end
local function reset(player, reason)
    local s = sessions[player]; if not s then return end
    s.Run = Rules.newRun(os.clock()); s.Heat = 0; s.Sprinting = false
    s.Stamina = 100+s.Profile.Upgrades.Stamina*20; s.Grace = os.clock()+5; s.Frozen = false
    local character = player.Character
    if character then
        character:PivotTo(world.Spawn)
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
    end
    s.LastPosition = world.Spawn.Position
    if reason then tell(player, reason, "warning") end
    push(player)
end
local function alive(player)
    local c = player.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
    return c and h and h.Health>0 and c:FindFirstChild("HumanoidRootPart")
end
local function canInteract(player, node)
    local s = sessions[player]; local root = alive(player)
    if not s or not root or s.Frozen or not Profiles:Available(player) then return false end
    if os.clock() - s.LastInteract < 0.45 or (root.Position-node.Part.Position).Magnitude>12 then return false end
    local params = RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={player.Character,world.Actors}
    local hit = workspace:Raycast(root.Position, node.Part.Position-root.Position, params)
    if hit and hit.Instance ~= node.Part then return false end
    s.LastInteract=os.clock()
    return true
end
for id, node in pairs(world.Nodes) do
    node.Prompt.Triggered:Connect(function(player)
        if not canInteract(player,node) then return end
        local s=sessions[player]
        local ok,message,result=Rules.interact(s.Run,s.Profile,id,os.clock(),Config)
        tell(player,message,if ok then "success" else "warning",result)
        if result then
            s.Frozen=true; s.Sprinting=false
            task.spawn(function() if Profiles:Save(player) then Profiles:UpdateRanking(player) end end)
            task.delay(5,function() if sessions[player]==s then reset(player) end end)
        end
        push(player)
    end)
end
local function checkVIP(player)
    local s=sessions[player]; if not s or Config.Passes.VIP.Id<=0 then return end
    local ok,owns=pcall(Market.UserOwnsGamePassAsync,Market,player.UserId,Config.Passes.VIP.Id)
    if ok and sessions[player]==s then s.VIP=owns; appearance(player); push(player) end
end
local function spawnCharacter(player,character)
    local root=character:WaitForChild("HumanoidRootPart",10)
    if not root or not sessions[player] or player.Character~=character then return end
    reset(player); appearance(player)
end
local function join(player)
    if joining[player] or sessions[player] or closing then return end
    joining[player]=true
    local stored,problem=Profiles:Load(player)
    joining[player]=nil
    if not stored then if player.Parent then player:Kick(problem) end; return end
    if not player.Parent or closing then Profiles:Release(player); return end
    sessions[player]={Profile=stored.Data,Run=Rules.newRun(os.clock()),Heat=0,Stamina=100+stored.Data.Upgrades.Stamina*20,
        Sprinting=false,Grace=os.clock()+5,Frozen=false,VIP=false,LastInteract=0,Tokens=10,TokenTime=os.clock(),LastBoard=0}
    local stats=Instance.new("Folder"); stats.Name="leaderstats"; stats.Parent=player
    for _,name in ipairs({"Cash","Escapes","Rescues"}) do local value=Instance.new("IntValue"); value.Name=name; value.Parent=stats end
    player.CharacterAdded:Connect(function(character) task.spawn(spawnCharacter,player,character) end)
    player.CharacterAppearanceLoaded:Connect(function() appearance(player) end)
    if player.Character then task.spawn(spawnCharacter,player,player.Character) end
    task.spawn(checkVIP,player)
    tell(player,"You play as "..Config.PlayerRole.." in an invented escape story. Find the keycard.")
    push(player)
end
Players.PlayerAdded:Connect(join)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(join,player) end
Players.PlayerRemoving:Connect(function(player)
    sessions[player]=nil
    Profiles:Release(player)
end)
local function allowRequest(s)
    local now=os.clock(); s.Tokens=math.min(10,s.Tokens+(now-s.TokenTime)*5); s.TokenTime=now
    if s.Tokens<1 then return false end
    s.Tokens-=1; return true
end
action.OnServerEvent:Connect(function(player,verb,arg)
    local s=sessions[player]
    if not s or type(verb)~="string" or #verb>30 then return end
    if verb=="Sprint" and arg==false then s.Sprinting=false; return end
    if not allowRequest(s) then return end
    if verb=="Ready" then push(player); return end
    if verb=="Board" then
        if os.clock()-s.LastBoard<3 then return end
        s.LastBoard=os.clock()
        if not Profiles.Persistent then Profiles:RefreshBoard() end
        board:FireClient(player,Profiles.Board,Profiles.BoardStatus); return
    end
    if not Profiles:Available(player) or s.Frozen then return end
    if verb=="Sprint" and type(arg)=="boolean" then s.Sprinting=arg and s.Stamina>10; return end
    if type(arg)~="string" or #arg>40 then return end
    if verb=="Skin" or verb=="Upgrade" then
        local ok,message=Rules.buy(s.Profile,verb,arg,Config)
        if ok then appearance(player) end
        tell(player,message,if ok then "success" else "warning"); push(player)
    elseif verb=="Product" or verb=="Pass" then
        local item=if verb=="Product" then Config.Products[arg] else Config.Passes[arg]
        if not item or item.Id<=0 then tell(player,"This item isn't available yet.","warning"); return end
        if not Profiles.Persistent then tell(player,"Purchases are disabled in the Studio practice session.","warning"); return end
        if verb=="Pass" and s.VIP then tell(player,"You already own VIP."); return end
        local ok=pcall(function()
            if verb=="Product" then Market:PromptProductPurchase(player,item.Id)
            else Market:PromptGamePassPurchase(player,item.Id) end
        end)
        if not ok then tell(player,"Roblox couldn't open the purchase window. Try again later.","warning") end
    end
end)
Market.ProcessReceipt=function(receipt)
    local pending=Enum.ProductPurchaseDecision.NotProcessedYet
    local player=Players:GetPlayerByUserId(receipt.PlayerId)
    if not player or not Profiles.Persistent or not Profiles:Available(player) then return pending end
    local product
    for _,item in pairs(Config.Products) do if item.Id>0 and item.Id==receipt.ProductId then product=item; break end end
    if not product then return pending end
    local ok=Profiles:Save(player,{Id=receipt.PurchaseId,Credits=product.Credits})
    if not ok then return pending end
    push(player)
    tell(player,"Purchase confirmed. Your cash balance is up to date.","success")
    return Enum.ProductPurchaseDecision.PurchaseGranted
end
Market.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
    if id==Config.Passes.VIP.Id and purchased then
        local s=sessions[player]
        if s then s.VIP=true; appearance(player); push(player) end
    end
end)
local timer,uiTimer=0,0
RunService.Heartbeat:Connect(function(dt)
    timer+=dt; uiTimer+=dt
    if timer<0.1 then return end
    local step=math.min(timer,0.3); timer=0
    for player,s in pairs(sessions) do
        local root=alive(player)
        local h=root and player.Character:FindFirstChildOfClass("Humanoid")
        if h then
            local available=Profiles:Available(player)
            local moving=h.MoveDirection.Magnitude>0.1
            local sprint=s.Sprinting and s.Stamina>0 and moving and available and not s.Frozen
            local maxStamina=100+s.Profile.Upgrades.Stamina*20
            s.Stamina=math.clamp(s.Stamina+step*(if sprint then -24 else 18),0,maxStamina)
            if s.Stamina<=0 then s.Sprinting=false end
            h.WalkSpeed=if s.Frozen or not available then 0 elseif sprint then 25+s.Profile.Upgrades.Sprint*2 else 16
            if root.Position.Y< -10 or math.abs(root.Position.X)>130 or math.abs(root.Position.Z)>180 then
                reset(player,"Back at intake. Your saved cash and upgrades are safe.")
            elseif s.LastPosition and os.clock()>s.Grace and (root.Position-s.LastPosition).Magnitude>math.max(40,step*h.WalkSpeed*4) then
                reset(player,"Movement reset. Start a fresh escape run.")
            end
            s.LastPosition=root.Position
        end
    end
    patrols:Step(step,sessions,function(player) reset(player,"Caught by patrol! Run rewards reset; your cash and upgrades are safe.") end)
    if uiTimer>=0.3 then uiTimer=0; for player in pairs(sessions) do push(player) end end
end)
task.spawn(function()
    while not closing do
        task.wait(Config.SaveInterval)
        for player in pairs(sessions) do
            task.spawn(function()
                local ok=Profiles:Save(player)
                if ok then Profiles:UpdateRanking(player); push(player)
                else
                    local stored=Profiles.Sessions[player]
                    if stored and os.time()>=stored.LeaseUntil-10 then player:Kick("Storage connection lost. Please rejoin to protect your progress.") end
                end
            end)
        end
    end
end)
task.spawn(function()
    while not closing do Profiles:RefreshBoard(); task.wait(60) end
end)
game:BindToClose(function()
    closing=true
    for player in pairs(Profiles.Sessions) do task.spawn(function() Profiles:Release(player) end) end
    local deadline=os.clock()+27
    repeat task.wait(0.1) until (not next(Profiles.Sessions) and not next(joining)) or os.clock()>deadline
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Patrols</string>
          <string name="Source"><![CDATA[local Pathfinding = game:GetService("PathfindingService")
local World = require(script.Parent.World)
local Patrols = {}
Patrols.__index = Patrols
function Patrols.new(world)
    local self = setmetatable({ World = world, Guards = {} }, Patrols)
    local routes = {
        { Vector3.new(-14,3.3,-40), Vector3.new(-14,3.3,35), Vector3.new(14,3.3,35), Vector3.new(14,3.3,-40) },
        { Vector3.new(14,3.3,-10), Vector3.new(14,3.3,62), Vector3.new(-14,3.3,62), Vector3.new(-14,3.3,-10) },
        { Vector3.new(-10,3.3,70), Vector3.new(10,3.3,70), Vector3.new(10,3.3,15), Vector3.new(-10,3.3,15) },
    }
    for i, route in ipairs(routes) do
        local model = World.figure(world.Actors, "GUARD " .. string.format("%02d",i), route[1], Color3.fromRGB(40,91,153), true)
        table.insert(self.Guards, { Model = model, Route = route, Index = 2, Replan = 0, LastSeen = 0, PathIndex = 1 })
    end
    return self
end
function Patrols:Step(dt, sessions, caught)
    local now = os.clock()
    local ignore = { self.World.Actors }
    for player in pairs(sessions) do if player.Character then table.insert(ignore, player.Character) end end
    local rays = RaycastParams.new(); rays.FilterType = Enum.RaycastFilterType.Exclude; rays.FilterDescendantsInstances = ignore
    local spotted = {}
    for _, guard in ipairs(self.Guards) do
        local position = guard.Model:GetPivot().Position
        local nearest, nearestDist = nil, math.huge
        for player, s in pairs(sessions) do
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if root and humanoid and humanoid.Health > 0 and not s.Frozen and s.Run.Key and now > s.Grace then
                local delta = root.Position - position
                local distance = delta.Magnitude
                local facing = distance < 8 or (distance > 0 and guard.Model:GetPivot().LookVector:Dot(delta.Unit) > 0.15)
                if distance < 36 and facing and not workspace:Raycast(position, delta, rays) then
                    spotted[player] = true
                    if distance < nearestDist then nearest = player; nearestDist = distance end
                    if s.Heat >= 0.65 and distance < 5 then caught(player) end
                end
            end
        end
        if nearest then guard.Target = nearest; guard.LastSeen = now end
        if now - guard.LastSeen > 4 or (guard.Target and not sessions[guard.Target]) then guard.Target = nil end
        local targetState = guard.Target and sessions[guard.Target]
        local root = guard.Target and guard.Target.Character and guard.Target.Character:FindFirstChild("HumanoidRootPart")
        local chasing = root and targetState and targetState.Run.Key and not targetState.Frozen and targetState.Heat >= 0.3
        local goal = if chasing then root.Position else guard.Route[guard.Index]
        goal = Vector3.new(goal.X, 3.3, goal.Z)
        if not chasing and (goal-position).Magnitude < 2 then
            guard.Index = guard.Index % #guard.Route + 1; goal = guard.Route[guard.Index]
        end
        local destination = goal
        if workspace:Raycast(position, goal-position, rays) then
            if now > guard.Replan and not guard.Computing then
                guard.Replan = now + 1; guard.Computing = true
                local from, to = position - Vector3.new(0,2.8,0), goal - Vector3.new(0,2.8,0)
                task.spawn(function()
                    local path = Pathfinding:CreatePath({ AgentRadius = 2, AgentHeight = 6, AgentCanJump = false, WaypointSpacing = 4 })
                    local ok = pcall(function() path:ComputeAsync(from, to) end)
                    guard.Path = if ok and path.Status == Enum.PathStatus.Success then path:GetWaypoints() else nil
                    guard.PathIndex = 2; guard.Computing = false
                end)
            end
            local waypoint = guard.Path and guard.Path[guard.PathIndex]
            if waypoint then
                destination = Vector3.new(waypoint.Position.X, 3.3, waypoint.Position.Z)
                if (destination-position).Magnitude < 2 then guard.PathIndex += 1 end
            else destination = position end
        else guard.Path = nil end
        local delta = destination-position
        if delta.Magnitude > 0.1 then
            local step = delta.Unit * math.min(delta.Magnitude, dt * (if chasing then 19 else 9))
            -- Check each step as well so stale paths cannot cut through a closed wall.
            if not workspace:Raycast(position, step, rays) then
                guard.Model:PivotTo(CFrame.lookAt(position+step, position+step+delta.Unit))
            end
        end
    end
    for player, s in pairs(sessions) do
        local rate = if spotted[player] then 0.65 / (1 + s.Profile.Upgrades.Stealth * 0.25) else -0.28
        s.Heat = math.clamp(s.Heat + rate * dt, 0, 1)
    end
end
return Patrols
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[local DSS = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Config)
local Rules = require(RS.Rules)
local Data = require(RS.ProfileData)
local Profiles = { Sessions = {}, Board = {}, BoardStatus = "Loading rankings" }
Profiles.Persistent = not RunService:IsStudio() or Config.StudioPersistence
local store = if Profiles.Persistent then DSS:GetDataStore(Config.StoreName) else nil
local ranking = if Profiles.Persistent then DSS:GetOrderedDataStore(Config.RankingName) else nil
local token = game.JobId .. ":" .. HttpService:GenerateGUID(false)
local names = {}

local function validProfile(d)
    if type(d) ~= "table" or type(d.Owned) ~= "table" or type(d.Upgrades) ~= "table" then return false end
    for _, key in ipairs({ "Cash", "Escapes", "Rescues", "BestMs" }) do
        if type(d[key]) ~= "number" or d[key] ~= d[key] or math.abs(d[key]) > 1e14 or d[key] % 1 ~= 0 then return false end
    end
    if d.Escapes < 0 or d.Rescues < 0 or d.BestMs < 0 or not Config.Skins[d.Skin] or not d.Owned[d.Skin] then return false end
    for name, upgrade in pairs(Config.Upgrades) do
        local n = d.Upgrades[name]
        if type(n) ~= "number" or n % 1 ~= 0 or n < 0 or n > upgrade.Max then return false end
    end
    return true
end

function Profiles:Load(player)
    if not self.Persistent then
        local s = { Data = Rules.newProfile(), LeaseUntil = math.huge, LastSave = os.clock() }
        self.Sessions[player] = s
        return s
    end
    local success, record, reason
    local sessionToken = token .. ":" .. HttpService:GenerateGUID(false)
    for attempt = 1, 3 do
        success, record = pcall(function()
            return store:UpdateAsync(tostring(player.UserId), function(old)
                if old and (not validProfile(old.Data) or type(old.Purchased) ~= "number" or old.Purchased < 0
                    or old.Purchased ~= old.Purchased or old.Purchased % 1 ~= 0 or type(old.Receipts) ~= "table") then
                    reason = "Stored profile could not be validated. Your data has been left unchanged."
                    return nil
                end
                local result, problem = Data.acquire(old, Rules.newProfile(), sessionToken, os.time(), Config.LeaseSeconds)
                reason = problem
                return result
            end)
        end)
        if success then break end
        task.wait(attempt)
    end
    if not success or not record then return nil, reason or "Profile storage unavailable. Please rejoin shortly." end
    record.Data.Purchased = record.Purchased
    local s = { Data = record.Data, Token = sessionToken, LeaseUntil = record.Lease.Expires,
        LastSave = os.clock(), CommittedEscapes = record.Data.Escapes }
    self.Sessions[player] = s
    return s
end

function Profiles:Available(player)
    local s = self.Sessions[player]
    return s ~= nil and not s.Closing and not s.Lost and os.time() < s.LeaseUntil - 10
end

function Profiles:Save(player, receipt, release)
    local s = self.Sessions[player]
    if not s or s.Lost or (s.Closing and not release) then return false end
    if release then s.Closing = true end
    local deadline = os.clock() + 20
    while s.Busy and os.clock() < deadline do task.wait(0.05) end
    if s.Busy or s.Lost then return false end
    -- A release may have started while this caller was waiting on the write lock.
    if s.Closing and not release then return false end
    if not self.Persistent then return receipt == nil end
    s.Busy = true
    local snapshot = Data.copy(s.Data)
    local reason
    local ok, result = pcall(function()
        return store:UpdateAsync(tostring(player.UserId), function(old)
            local nextRecord, problem = Data.commit(old, snapshot, s.Token, os.time(), Config.LeaseSeconds, receipt, release)
            reason = problem
            return nextRecord
        end)
    end)
    if ok and result then
        -- Never replace the live wallet: gameplay can award/spend earned funds during a write.
        -- The purchased ledger is independent and monotonic, including ambiguous previous writes.
        s.Data.Purchased = result.Purchased
        s.LastSave = os.clock()
        s.CommittedEscapes = snapshot.Escapes
        if not release then s.LeaseUntil = result.Lease.Expires end
    elseif ok and reason then
        s.Lost = true
        player:Kick("Your profile moved to another server. Please rejoin.")
    else
        warn("Lockbreak: profile write failed for user " .. player.UserId .. "; keeping data in memory.")
    end
    s.Busy = false
    return ok and result ~= nil
end

function Profiles:Release(player)
    local s = self.Sessions[player]
    if not s then return end
    if s.Releasing then
        while self.Sessions[player] == s do task.wait(0.05) end
        return
    end
    s.Releasing = true; s.Closing = true
    for attempt = 1, 3 do
        if self:Save(player, nil, true) then break end
        if s.Lost then break end
        task.wait(attempt)
    end
    self.Sessions[player] = nil
end

function Profiles:UpdateRanking(player)
    local s = self.Sessions[player]
    if not ranking or not s then return end
    local score = s.CommittedEscapes or 0
    local ok = pcall(function()
        ranking:UpdateAsync(tostring(player.UserId), function(old) return math.max(old or 0, score) end)
    end)
    if not ok then warn("Lockbreak: ranking update unavailable; profile and rewards are unaffected.") end
end

function Profiles:RefreshBoard()
    if not ranking then
        self.BoardStatus = "STUDIO SESSION · progress is temporary"
        self.Board = {}
        for p, s in pairs(self.Sessions) do table.insert(self.Board, { UserId = p.UserId, Name = p.DisplayName, Escapes = s.Data.Escapes }) end
        table.sort(self.Board, function(a, b) return a.Escapes > b.Escapes end)
        return
    end
    local ok, page = pcall(function() return ranking:GetSortedAsync(false, 10):GetCurrentPage() end)
    if not ok then self.BoardStatus = "Rankings unavailable · showing last successful update"; return end
    self.BoardStatus = "GLOBAL · updates about once a minute"
    local rows = {}
    for _, entry in ipairs(page) do
        local id = tonumber(entry.key)
        if id then
            if not names[id] then
                local player = Players:GetPlayerByUserId(id)
                if player then names[id] = player.DisplayName
                else
                    local resolved, name = pcall(Players.GetNameFromUserIdAsync, Players, id)
                    if resolved then names[id] = name end
                end
            end
            table.insert(rows, { UserId = id, Name = names[id] or ("Player " .. entry.key), Escapes = entry.value })
        end
    end
    self.Board = rows
end
return Profiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local World = {}
local C = {
    Concrete = Color3.fromRGB(76, 86, 99), Dark = Color3.fromRGB(30, 39, 51),
    White = Color3.fromRGB(220, 233, 235), Orange = Color3.fromRGB(244, 155, 65),
    Mint = Color3.fromRGB(79, 230, 186), Blue = Color3.fromRGB(66, 147, 224),
}
local function part(parent, name, size, cf, color, material)
    local p = Instance.new("Part")
    p.Name = name; p.Size = size; p.CFrame = if typeof(cf) == "CFrame" then cf else CFrame.new(cf)
    p.Anchored = true; p.Color = color or C.Concrete; p.Material = material or Enum.Material.Concrete
    p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth; p.Parent = parent
    return p
end
local function label(parent, text, color, offset, width)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"; gui.Size = UDim2.fromOffset(width or 230, 56); gui.StudsOffset = offset or Vector3.new(0, 4, 0)
    gui.MaxDistance = 85; gui.AlwaysOnTop = false; gui.Parent = parent
    local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1); t.BackgroundColor3 = C.Dark
    t.BackgroundTransparency = 0.15; t.TextColor3 = color or C.White; t.Font = Enum.Font.GothamBold
    t.TextSize = 15; t.TextWrapped = true; t.Text = text; t.Parent = gui
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 8); corner.Parent = t
    return t
end
function World.figure(parent, name, position, color, police)
    local model = Instance.new("Model"); model.Name = name; model.Parent = parent
    local root = part(model, "Root", Vector3.new(2, 2, 1), position, color); root.Transparency = 1; root.CanCollide = false
    model.PrimaryPart = root
    part(model, "Torso", Vector3.new(2, 2, 1), position, color)
    part(model, "Head", Vector3.new(1.35, 1.35, 1.35), position + Vector3.new(0, 1.7, 0), Color3.fromRGB(194, 149, 112))
    for _, x in ipairs({ -0.53, 0.53 }) do part(model, "Leg", Vector3.new(0.9, 2, 1), position + Vector3.new(x, -2, 0), C.Dark) end
    for _, x in ipairs({ -1.5, 1.5 }) do part(model, "Arm", Vector3.new(0.8, 2, 1), position + Vector3.new(x, 0, 0), color) end
    -- Stylized original block figures; no external likeness or asset dependency.
    part(model, "Visor", Vector3.new(1.4, 0.35, 0.12), position + Vector3.new(0, 1.8, -0.72), C.Dark)
    if police then
        part(model, "Cap", Vector3.new(1.6, 0.35, 1.6), position + Vector3.new(0, 2.4, 0), C.Blue)
        part(model, "Badge", Vector3.new(0.3, 0.45, 0.08), position + Vector3.new(-0.5, 0.3, -0.55), C.Orange, Enum.Material.Metal)
    end
    for _, p in ipairs(model:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false; p.CanQuery = false end end
    label(root, name, if police then C.Blue else C.Orange, Vector3.new(0, 4.5, 0))
    return model
end
function World.build(config)
    local existing = workspace:FindFirstChild("LockbreakWorld")
    if existing then
        assert(existing:GetAttribute("GeneratedBy") == "Lockbreak", "An unrelated LockbreakWorld folder already exists.")
        local nodes, inmates = {}, {}
        local actors = assert(existing:FindFirstChild("Actors"), "Generated world is missing Actors")
        for _, item in ipairs(existing:GetDescendants()) do
            if item:IsA("BasePart") and item:GetAttribute("InteractionId") then
                nodes[item:GetAttribute("InteractionId")] = { Part = item, Prompt = assert(item:FindFirstChildOfClass("ProximityPrompt")) }
            elseif item:IsA("Model") and item:GetAttribute("InmateId") then inmates[item:GetAttribute("InmateId")] = item end
        end
        return { Folder = existing, Actors = actors, Nodes = nodes, Inmates = inmates, Spawn = CFrame.new(0, 5, -70) }
    end
    local folder = Instance.new("Folder"); folder.Name = "LockbreakWorld"; folder.Parent = workspace
    folder:SetAttribute("GeneratedBy", "Lockbreak")
    local actors = Instance.new("Folder"); actors.Name = "Actors"; actors.Parent = folder
    local nodes, inmates = {}, {}
    local function p(name, size, pos, color, material) return part(folder, name, size, pos, color, material) end
    local function interact(id, target, title, description)
        local q = Instance.new("ProximityPrompt"); q.Name = "Interact"; q.ActionText = title; q.ObjectText = description
        q.HoldDuration = if id == "power" then 2 else 0.7; q.MaxActivationDistance = 10; q.RequiresLineOfSight = true
        q.KeyboardKeyCode = Enum.KeyCode.E; q.GamepadKeyCode = Enum.KeyCode.ButtonX; q.Parent = target
        target:SetAttribute("InteractionId", id)
        nodes[id] = { Part = target, Prompt = q }
    end
    local function room(name, x, z, w, d)
        p(name .. " foundation", Vector3.new(w, 0.3, d), Vector3.new(x, 0.15, z), C.Dark)
        p(name .. " rear", Vector3.new(w, 13, 1), Vector3.new(x, 6.5, z + d/2))
        for _, side in ipairs({ -1, 1 }) do
            p(name .. " side", Vector3.new(1, 13, d), Vector3.new(x + side*w/2, 6.5, z))
            p(name .. " front", Vector3.new(w/2-5, 13, 1), Vector3.new(x + side*(w/4+2.5), 6.5, z-d/2))
        end
        local lintel = p(name .. " lintel", Vector3.new(w, 2, 1), Vector3.new(x, 12, z-d/2), C.Dark)
        label(lintel, name, C.White, Vector3.new(0, 2, 0))
        p(name .. " light", Vector3.new(w-3, 0.3, 0.4), Vector3.new(x, 10.6, z+d/2-1), C.Orange, Enum.Material.Neon)
    end
    local ocean = p("Ocean", Vector3.new(1600, 2, 1600), Vector3.new(0, -5, 0), Color3.fromRGB(22, 71, 91), Enum.Material.SmoothPlastic)
    ocean.CanCollide = false; ocean.CanQuery = false
    p("Island", Vector3.new(195, 5, 235), Vector3.new(0, -2.5, 0), Color3.fromRGB(88, 102, 82), Enum.Material.Grass)
    p("Prison yard", Vector3.new(146, 0.2, 178), Vector3.new(0, 0.1, -5), Color3.fromRGB(100, 110, 111))
    p("Main walkway", Vector3.new(22, 0.25, 172), Vector3.new(0, 0.24, -5), C.Dark, Enum.Material.Asphalt)
    for z = -76, 72, 13 do p("Walkway marking", Vector3.new(0.35, 0.05, 5), Vector3.new(0, 0.39, z), C.Orange) end
    for _, x in ipairs({ -75, 75 }) do p("Perimeter wall", Vector3.new(3, 20, 184), Vector3.new(x, 10, -5)) end
    p("South wall", Vector3.new(153, 20, 3), Vector3.new(0, 10, -97))
    for _, x in ipairs({ -44, 44 }) do p("North wall", Vector3.new(64, 20, 3), Vector3.new(x, 10, 87)) end
    for _, x in ipairs({ -75, 75 }) do
        for z = -90, 85, 7 do
            p("Fence post", Vector3.new(0.35, 4, 0.35), Vector3.new(x, 22, z), C.Dark, Enum.Material.Metal)
        end
        for y = 21, 23, 1 do p("Fence rail", Vector3.new(0.16, 0.16, 180), Vector3.new(x, y, -3), C.Dark, Enum.Material.Metal) end
    end
    for _, x in ipairs({ -67, 67 }) do
        for _, z in ipairs({ -85, 74 }) do
            p("Watchtower", Vector3.new(9, 24, 9), Vector3.new(x, 12, z), C.Dark)
            p("Watchtower cabin", Vector3.new(14, 7, 14), Vector3.new(x, 27, z))
            p("Watchtower roof", Vector3.new(17, 1, 17), Vector3.new(x, 31, z), C.Dark)
            local lamp = p("Tower beacon", Vector3.new(1, 1, 1), Vector3.new(x, 32, z), C.Orange, Enum.Material.Neon)
            local light = Instance.new("PointLight"); light.Color = C.Orange; light.Range = 25; light.Brightness = 1; light.Parent = lamp
        end
    end
    local spawn = Instance.new("SpawnLocation"); spawn.Name = "IntakeSpawn"; spawn.Size = Vector3.new(12, 0.4, 12)
    spawn.CFrame = CFrame.new(0, 0.6, -70); spawn.Anchored = true; spawn.Neutral = true; spawn.Duration = 0
    spawn.Transparency = 1; spawn.Parent = folder
    local sign = p("Welcome sign", Vector3.new(25, 5, 0.7), Vector3.new(0, 8, -87), C.Dark)
    label(sign, "LOCKBREAK ISLAND\nINTAKE / SOUTH WING", C.Orange, Vector3.zero, 300)
    for _, x in ipairs({ -42, 42 }) do
        room("INTAKE", x, -70, 34, 28)
        for offset = -10, 10, 10 do
            p("Bunk frame", Vector3.new(6, 1, 4), Vector3.new(x + offset, 1.5, -73), C.Dark, Enum.Material.Metal)
            p("Bunk mattress", Vector3.new(6, 0.5, 4), Vector3.new(x + offset, 2.25, -73), Color3.fromRGB(109, 133, 146))
        end
    end
    room("GUARD OFFICE", -48, -20, 32, 34)
    p("Guard desk", Vector3.new(14, 3, 5), Vector3.new(-48, 1.5, -14), C.Dark)
    local key = p("Guard keycard", Vector3.new(2.5, 0.2, 1.6), Vector3.new(-44, 3.2, -14), C.Orange, Enum.Material.Neon)
    label(key, "01 / KEYCARD", C.Orange, Vector3.new(0, 3, 0)); interact("key", key, "Steal keycard", "Guard desk")
    local monitor = p("Security monitor", Vector3.new(5, 3, 0.5), Vector3.new(-52, 4.5, -12), C.Dark)
    p("Monitor display", Vector3.new(4.5, 2.4, 0.1), monitor.CFrame * CFrame.new(0, 0, -0.3), C.Mint, Enum.Material.Neon)
    room("UTILITY YARD", 47, 15, 34, 36)
    local generator = p("Security generator", Vector3.new(10, 6, 7), Vector3.new(47, 3, 18), C.Dark, Enum.Material.Metal)
    for x = 43, 51, 2 do p("Generator fin", Vector3.new(0.5, 5, 7.5), Vector3.new(x, 3, 18), C.Concrete, Enum.Material.Metal) end
    local switch = p("Power switch", Vector3.new(2, 2, 0.3), Vector3.new(47, 4, 14.2), C.Mint, Enum.Material.Neon)
    label(generator, "02 / SECURITY POWER", C.Mint, Vector3.new(0, 6, 0)); interact("power", switch, "Cut security power", "Generator controls")
    for i, cast in ipairs(config.Cast) do
        local x = if i == 1 then -42 else 42
        room("CELL " .. cast.Cell, x, 57, 32, 24)
        for barX = x-4, x+4, 2 do p("Cell bars", Vector3.new(0.3, 10, 0.3), Vector3.new(barX, 5, 45), C.Dark, Enum.Material.Metal) end
        local inmate = World.figure(actors, cast.Name, Vector3.new(x, 3.3, 52), C.Orange, false)
        inmate:SetAttribute("InmateId", cast.Id); inmates[cast.Id] = inmate
        local release = p("Cell release", Vector3.new(1.4, 2, 0.8), Vector3.new(x + 7, 4, 44), C.Orange, Enum.Material.Neon)
        interact("rescue:" .. cast.Id, release, "Free " .. cast.Name, "Optional rescue / +75 on escape")
    end
    local workshop = World.figure(actors, "Workshop foreman", Vector3.new(-47, 3.3, 22), C.Mint, false)
    interact("foreman", workshop.PrimaryPart, "Deliver five scrap bundles", "Workshop / +100 on escape")
    p("Workshop bench", Vector3.new(15, 3, 5), Vector3.new(-48, 1.5, 28), C.Dark)
    local scrapPositions = { Vector3.new(-24, 1, -55), Vector3.new(24, 1, -40), Vector3.new(-28, 1, 5), Vector3.new(24, 1, 32), Vector3.new(0, 1, 64) }
    for i, pos in ipairs(scrapPositions) do
        local scrap = p("Scrap bundle " .. i, Vector3.new(2, 1.5, 2), pos, C.Orange, Enum.Material.DiamondPlate)
        interact("scrap:" .. i, scrap, "Collect scrap " .. i, "Workshop supply")
    end
    local radio = p("Dock radio", Vector3.new(3, 2, 2), Vector3.new(-15, 3, 100), C.Dark, Enum.Material.Metal)
    p("Radio table", Vector3.new(6, 2, 4), Vector3.new(-15, 1, 100), C.Concrete)
    p("Radio antenna", Vector3.new(0.2, 6, 0.2), Vector3.new(-16, 6, 100), C.Dark, Enum.Material.Metal)
    interact("radio", radio, "Send escape coordinates", "Radio side quest / +80 on escape")
    p("Dock", Vector3.new(14, 1, 35), Vector3.new(0, 0.5, 115), Color3.fromRGB(107, 91, 77), Enum.Material.WoodPlanks)
    local boat = p("Escape boat", Vector3.new(15, 2, 22), Vector3.new(0, 0, 137), C.Dark, Enum.Material.Metal)
    for _, x in ipairs({ -6.5, 6.5 }) do p("Boat rail", Vector3.new(1, 3, 22), Vector3.new(x, 2, 137), C.White) end
    p("Boat cabin", Vector3.new(9, 4, 7), Vector3.new(0, 3, 141), C.White)
    local exit = p("Boat boarding point", Vector3.new(7, 0.3, 4), Vector3.new(0, 1.2, 129), C.Mint, Enum.Material.Neon)
    label(boat, "03 / ESCAPE BOAT", C.Mint, Vector3.new(0, 8, 0)); interact("exit", exit, "Escape the island", "Complete your run")
    for _, x in ipairs({ -20, 20 }) do
        for z = -50, 70, 40 do
            p("Yard lamp post", Vector3.new(0.5, 12, 0.5), Vector3.new(x, 6, z), C.Dark, Enum.Material.Metal)
            local lamp = p("Yard lamp", Vector3.new(3, 0.5, 2), Vector3.new(x, 12, z), C.White, Enum.Material.Neon)
            local light = Instance.new("PointLight"); light.Range = 24; light.Brightness = 1.5; light.Color = C.White; light.Parent = lamp
        end
    end
    Lighting.ClockTime = 17.6; Lighting.Brightness = 2; Lighting.Ambient = Color3.fromRGB(100, 112, 135)
    Lighting.OutdoorAmbient = Color3.fromRGB(118, 133, 155)
    Lighting.FogColor = Color3.fromRGB(115, 155, 170); Lighting.FogStart = 300; Lighting.FogEnd = 1100
    return { Folder = folder, Actors = actors, Nodes = nodes, Inmates = inmates, Spawn = CFrame.new(0, 5, -70) }
end
return World
]]></string>
        </Properties>
      </Item>
