local totals=text(header,"0 ESCAPES  /  0 RESCUES",UDim2.new(0.45,-20,0,20),UDim2.new(0.55,0,0,44),11,palette.Muted,true); totals.TextXAlignment=Enum.TextXAlignment.Right
