local Rules=require('../src/ReplicatedStorage/Rules')
local Data=require('../src/ReplicatedStorage/ProfileData')
local Config=require('../src/ReplicatedStorage/Config')
local passed,failed=0,0
local function equal(actual,expected) assert(actual==expected,'expected '..tostring(expected)..', got '..tostring(actual)) end
local function test(name,fn)
    local ok,err=pcall(fn)
    if ok then passed+=1; print('PASS '..name) else failed+=1; print('FAIL '..name..': '..tostring(err)) end
end
local function setup() return Rules.newRun(10),Rules.newProfile() end
local function unlock(run,p)
    assert(Rules.interact(run,p,'key',12,Config))
    assert(Rules.interact(run,p,'power',20,Config))
end
test('escape requires keycard and generator',function()
    local r,p=setup(); equal(Rules.interact(r,p,'exit',20,Config),false); equal(p.Cash,0); equal(p.Escapes,0)
    Rules.interact(r,p,'key',21,Config); equal(Rules.interact(r,p,'exit',22,Config),false)
end)
test('security cannot be disabled before key theft',function()
    local r,p=setup(); equal(Rules.interact(r,p,'power',20,Config),false); equal(r.Power,false)
end)
test('rescue and radio require disabled security',function()
    local r,p=setup(); equal(Rules.interact(r,p,'rescue:mogul',20,Config),false); equal(Rules.interact(r,p,'radio',20,Config),false)
    equal(Rules.count(r.Rescued),0); equal(r.RadioDone,false)
end)
test('full escape pays the exact combined rewards once',function()
    local r,p=setup(); unlock(r,p)
    for _,cast in ipairs(Config.Cast) do assert(Rules.interact(r,p,'rescue:'..cast.Id,22,Config)) end
    for i=1,5 do assert(Rules.interact(r,p,'scrap:'..i,25,Config)) end
    assert(Rules.interact(r,p,'foreman',30,Config)); assert(Rules.interact(r,p,'radio',40,Config))
    equal(p.Cash,0)
    local ok,_,result=Rules.interact(r,p,'exit',70,Config)
    equal(ok,true); equal(result.Reward,480); equal(p.Cash,480); equal(p.Escapes,1); equal(p.Rescues,2); equal(p.BestMs,60000)
    equal(Rules.interact(r,p,'exit',71,Config),false); equal(p.Cash,480); equal(p.Escapes,1)
end)
test('optional quests are not required to escape',function()
    local r,p=setup(); unlock(r,p); assert(Rules.interact(r,p,'exit',50,Config)); equal(p.Cash,150); equal(p.Rescues,0)
end)
test('duplicate rescue and quest completions do not stack',function()
    local r,p=setup(); unlock(r,p)
    assert(Rules.interact(r,p,'rescue:mogul',22,Config)); equal(Rules.interact(r,p,'rescue:mogul',23,Config),false)
    for i=1,5 do Rules.interact(r,p,'scrap:'..i,25,Config) end
    assert(Rules.interact(r,p,'foreman',30,Config)); equal(Rules.interact(r,p,'foreman',31,Config),false)
    assert(Rules.interact(r,p,'radio',30,Config)); equal(Rules.interact(r,p,'radio',31,Config),false)
    equal(Rules.count(r.Rescued),1)
end)
test('duplicate and invalid scrap cannot finish the quest',function()
    local r,p=setup()
    for i=1,10 do Rules.interact(r,p,'scrap:1',20,Config) end
    for _,id in ipairs({'scrap:0','scrap:6','scrap:1.5','scrap:01','scrap:1.0','scrap:garbage'}) do equal(Rules.interact(r,p,id,20,Config),false) end
    equal(Rules.count(r.Scrap),1); equal(Rules.interact(r,p,'foreman',21,Config),false)
end)
test('unknown interactions and cast IDs are rejected',function()
    local r,p=setup(); unlock(r,p)
    equal(Rules.interact(r,p,'rescue:unknown',25,Config),false); equal(Rules.interact(r,p,'payme',25,Config),false)
end)
test('capture discards unbanked rewards while preserving upgrades',function()
    local r,p=setup(); p.Cash=500; p.Upgrades.Sprint=2; unlock(r,p); Rules.interact(r,p,'rescue:mogul',25,Config)
    r=Rules.newRun(30); equal(r.Key,false); equal(Rules.count(r.Rescued),0); equal(p.Cash,500); equal(p.Upgrades.Sprint,2)
end)
test('best time improves but never gets worse',function()
    local r,p=setup(); unlock(r,p); Rules.interact(r,p,'exit',70,Config)
    r=Rules.newRun(100); unlock(r,p); Rules.interact(r,p,'exit',180,Config); equal(p.BestMs,60000)
    r=Rules.newRun(200); unlock(r,p); Rules.interact(r,p,'exit',240,Config); equal(p.BestMs,40000)
end)
test('insufficient funds cannot buy or equip a locked skin',function()
    local p=Rules.newProfile(); equal(Rules.buy(p,'Skin','Neon',Config),false); equal(p.Skin,'Intake'); equal(p.Owned.Neon,nil)
end)
test('owned skins equip without charging again',function()
    local p=Rules.newProfile(); p.Cash=1000
    assert(Rules.buy(p,'Skin','Midnight',Config)); equal(p.Cash,750)
    assert(Rules.buy(p,'Skin','Intake',Config)); assert(Rules.buy(p,'Skin','Midnight',Config)); equal(p.Cash,750)
end)
test('upgrade costs escalate and cap without additional charges',function()
    local p=Rules.newProfile(); p.Cash=2000
    for i=1,3 do assert(Rules.buy(p,'Upgrade','Sprint',Config)); equal(p.Upgrades.Sprint,i) end
    equal(p.Cash,800); equal(Rules.buy(p,'Upgrade','Sprint',Config),false); equal(p.Cash,800)
end)
test('unknown shop actions never mutate the wallet',function()
    local p=Rules.newProfile(); p.Cash=500
    equal(Rules.buy(p,'Skin','fake',Config),false); equal(Rules.buy(p,'Upgrade','fake',Config),false)
    equal(Rules.buy(p,'Give','cash',Config),false); equal(p.Cash,500)
end)
test('purchased credits can be spent without mutating the ledger',function()
    local p=Rules.newProfile(); p.Purchased=500
    assert(Rules.buy(p,'Skin','Midnight',Config)); equal(p.Cash,-250); equal(p.Purchased,500); equal(Rules.balance(p),250)
end)
test('mission objective follows the completed stage',function()
    local r,p=setup(); local step=Rules.objective(r); equal(step,'01')
    Rules.interact(r,p,'key',20,Config); step=Rules.objective(r); equal(step,'02')
    Rules.interact(r,p,'power',20,Config); step=Rules.objective(r); equal(step,'03')
end)
local function record() return Data.acquire(nil,Rules.newProfile(),'server-A',100,180) end
test('new profile acquisition creates a bounded session lease',function()
    local r=record(); equal(r.Lease.Owner,'server-A'); equal(r.Lease.Expires,280); equal(r.Purchased,0)
end)
test('active profile cannot be loaded by a competing server',function()
    local r=record(); local blocked=Data.acquire(r,Rules.newProfile(),'server-B',110,180)
    equal(blocked,nil); equal(r.Lease.Owner,'server-A')
end)
test('expired lease can be recovered without wiping progress',function()
    local r=record(); r.Data.Escapes=9
    local recovered=Data.acquire(r,Rules.newProfile(),'server-B',281,180)
    equal(recovered.Data.Escapes,9); equal(recovered.Lease.Owner,'server-B')
end)
test('stale server cannot save or grant paid credits after takeover',function()
    local r=Data.acquire(record(),Rules.newProfile(),'server-B',281,180)
    equal(Data.commit(r,Rules.newProfile(),'server-A',282,180,{Id='receipt1',Credits=500}),nil)
    equal(r.Purchased,0)
end)
test('receipt credit and deduplication ID are committed together',function()
    local r=record(); local p=Rules.newProfile(); p.Cash=100
    local result=Data.commit(r,p,'server-A',120,180,{Id='purchase-1',Credits=500})
    equal(result.Purchased,500); equal(result.Receipts['purchase-1'],500); equal(result.Data.Cash,100)
    equal(r.Purchased,0); equal(p.Purchased,0)
end)
test('replayed receipt never grants a second credit',function()
    local r=record(); local p=Rules.newProfile()
    r=Data.commit(r,p,'server-A',120,180,{Id='purchase-1',Credits=500})
    r=Data.commit(r,p,'server-A',130,180,{Id='purchase-1',Credits=500})
    equal(r.Purchased,500)
end)
test('different receipts each grant once',function()
    local r=record(); local p=Rules.newProfile()
    r=Data.commit(r,p,'server-A',120,180,{Id='purchase-1',Credits=500})
    r=Data.commit(r,p,'server-A',130,180,{Id='purchase-2',Credits=1500})
    equal(r.Purchased,2000)
end)
test('ambiguous receipt success survives later autosave and retry',function()
    local r=record(); local p=Rules.newProfile()
    r=Data.commit(r,p,'server-A',120,180,{Id='purchase-1',Credits=500})
    -- Simulate a committed write whose response was lost: live p has stale Purchased=0.
    p.Cash=150
    r=Data.commit(r,p,'server-A',130,180)
    equal(r.Purchased,500); equal(r.Data.Cash,150)
    r=Data.commit(r,p,'server-A',140,180,{Id='purchase-1',Credits=500}); equal(r.Purchased,500)
end)
test('receipt response cannot erase rewards earned while write yielded',function()
    local p=Rules.newProfile(); p.Cash=100; local snapshot=Data.copy(p)
    local r=Data.commit(record(),snapshot,'server-A',120,180,{Id='purchase-1',Credits=500})
    p.Cash+=150; p.Purchased=r.Purchased
    equal(Rules.balance(p),750)
    r=Data.commit(r,p,'server-A',130,180); equal(r.Data.Cash+r.Purchased,750)
end)
test('old client copy of purchased credits cannot overwrite the ledger',function()
    local p=Rules.newProfile(); local r=record()
    r=Data.commit(r,p,'server-A',120,180,{Id='purchase-1',Credits=500})
    p.Purchased=999999
    r=Data.commit(r,p,'server-A',130,180); equal(r.Purchased,500); equal(r.Data.Purchased,nil)
end)
test('release saves progress and permits immediate rejoin',function()
    local p=Rules.newProfile(); p.Escapes=7
    local r=Data.commit(record(),p,'server-A',130,180,nil,true); equal(r.Lease,nil)
    r=Data.acquire(r,Rules.newProfile(),'server-B',131,180); equal(r.Data.Escapes,7); equal(r.Lease.Owner,'server-B')
end)
test('deep snapshots do not alias live upgrade and ownership tables',function()
    local p=Rules.newProfile(); local snapshot=Data.copy(p); p.Upgrades.Sprint=3; p.Owned.Neon=true
    equal(snapshot.Upgrades.Sprint,0); equal(snapshot.Owned.Neon,nil)
end)
print(string.format('\n%d passed; %d failed',passed,failed))
assert(failed==0,'Test failures')
